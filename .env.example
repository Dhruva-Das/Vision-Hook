GROQ_API_KEY=your_groq_key_here
SARVAM_API_KEY=your_sarvam_key_here
SARVAM_SPEAKER=meera
STT_PROVIDER=groq
TTS_PROVIDER=sarvam
FRAME_ANALYSIS_INTERVAL=3
LLM_MODEL=llama-3.3-70b-versatile
LLM_MAX_TOKENS=1024

# Auth — leave empty to disable API key checking (dev mode)
API_KEY=
# Rate limiting — format: "count/period" (e.g., 60/minute, 10/second)
RATE_LIMIT=60/minute
# Max frame upload size in bytes (default 5MB)
MAX_FRAME_SIZE=5242880
# CORS origins — comma-separated list, or "*" for dev
CORS_ORIGINS=*